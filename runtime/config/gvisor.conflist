{
  "cniVersion": "1.0.0",
  "name": "livepeer-gvisor",
  "plugins": [{
    "type": "bridge",
    "bridge": "lp-gvisor0",
    "isDefaultGateway": true,
    "ipMasq": true,
    "portIsolation": true,
    "ipam": {
      "type": "host-local",
      "ranges": [[{"subnet": "10.44.0.0/16"}]]
    }
  }]
}
