# syntax=docker/dockerfile:1.7
# Build from the same digest-pinned Go Runtime distribution used by management.
ARG RUNTIME_IMAGE
FROM ${RUNTIME_IMAGE} AS runtime
FROM scratch
ADD --checksum=sha256:1f99fb518b83dec2ba8d870a7cc991d82a77e6196295a3d2754ba17ab9f91872 --chmod=0555 https://github.com/cloudflare/cloudflared/releases/download/2026.10.7/cloudflared-linux-amd64 /usr/local/bin/cloudflared
COPY --from=runtime /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=runtime /usr/local/bin/livepeer-runtime /usr/local/bin/livepeer-runtime
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/livepeer-runtime", "connector-start"]
