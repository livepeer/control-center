# syntax=docker/dockerfile:1
# Grafana 13.2.6 with the pinned VictoriaLogs datasource baked in, so the
# container never downloads plugins at startup.
FROM grafana/grafana:13.3.1@sha256:0615ec4fbd4072004b7d86b46ded63013a74b7d6eb1119273dd89e8fa25c13cf
ARG VICTORIALOGS_DATASOURCE_VERSION=v0.33.1
ARG VICTORIALOGS_DATASOURCE_SHA256=849edf4d86a6555bbf3fdbe1c53ed719a6c51c3d69965dcc0384e2c129ad991a
USER root
RUN set -eu; \
    mkdir -p /opt/grafana-plugins; \
    curl -fsSL --retry 3 -o /tmp/victorialogs.tar.gz \
      "https://github.com/VictoriaMetrics/victorialogs-datasource/releases/download/${VICTORIALOGS_DATASOURCE_VERSION}/victoriametrics-logs-datasource-${VICTORIALOGS_DATASOURCE_VERSION}.tar.gz"; \
    echo "${VICTORIALOGS_DATASOURCE_SHA256}  /tmp/victorialogs.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/victorialogs.tar.gz -C /opt/grafana-plugins; \
    rm /tmp/victorialogs.tar.gz; \
    chown -R root:root /opt/grafana-plugins; \
    chmod -R a+rX,go-w /opt/grafana-plugins
COPY deploy/grafana/provisioning /etc/grafana/provisioning
COPY deploy/grafana/dashboards /etc/grafana/dashboards
COPY --chmod=0755 deploy/grafana/entrypoint.sh /usr/local/bin/grafana-entrypoint
# Cloudflare Access is the only login. The entrypoint supplies the team's
# verification keys and expected claims and refuses to start without them.
ENV GF_PATHS_PLUGINS=/opt/grafana-plugins \
    GF_PATHS_PROVISIONING=/etc/grafana/provisioning \
    GF_PATHS_DATA=/var/lib/grafana \
    GF_LOG_MODE=console \
    GF_AUTH_JWT_ENABLED=true \
    GF_AUTH_JWT_HEADER_NAME=Cf-Access-Jwt-Assertion \
    GF_AUTH_JWT_EMAIL_CLAIM=email \
    GF_AUTH_JWT_USERNAME_CLAIM=email \
    GF_AUTH_JWT_AUTO_SIGN_UP=true \
    GF_AUTH_JWT_CACHE_TTL=60m \
    GF_AUTH_JWT_ROLE_ATTRIBUTE_PATH="'Editor'" \
    GF_AUTH_JWT_ROLE_ATTRIBUTE_STRICT=true \
    GF_AUTH_JWT_URL_LOGIN=false \
    GF_AUTH_DISABLE_LOGIN_FORM=true \
    GF_AUTH_BASIC_ENABLED=false \
    GF_AUTH_ANONYMOUS_ENABLED=false \
    GF_USERS_ALLOW_SIGN_UP=false \
    GF_SECURITY_DISABLE_INITIAL_ADMIN_CREATION=true \
    GF_SECURITY_COOKIE_SECURE=true \
    GF_ANALYTICS_REPORTING_ENABLED=false \
    GF_ANALYTICS_CHECK_FOR_UPDATES=false \
    GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false \
    GF_PLUGINS_PREINSTALL_DISABLED=true \
    GF_NEWS_NEWS_FEED_ENABLED=false
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/grafana-entrypoint"]
