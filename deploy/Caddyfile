{
	admin off
	auto_https off
}

:8080 {
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin

	handle /bootstrap.sh {
		root * /srv/bootstrap
		header Content-Type text/x-shellscript
		header Cache-Control no-cache
		file_server
	}

	handle /bootstrap/releases/* {
		root * /srv
		@missing not file
		header @missing Cache-Control no-store
		@published file
		header @published Cache-Control "public, max-age=31536000, immutable"
		@archive path *.tar.gz
		header @archive Content-Type application/gzip
		@script path *.sh
		header @script Content-Type text/x-shellscript
		file_server
	}

	handle /api/* {
		reverse_proxy api:43812
	}

	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control no-cache
		file_server
	}
}

:8081 {
	@secrets_metadata {
		path /internal/secrets/nodes/*
		method GET POST
	}
	handle @secrets_metadata {
		reverse_proxy api:43812
	}
	@private path /internal /internal/*
	handle @private {
		respond "Not found" 404
	}
	@tickets {
		path /redemption/tickets
		method POST
	}
	handle @tickets {
		uri strip_prefix /redemption
		reverse_proxy redeemer:8941
	}
	handle /redemption/* {
		respond "Not found" 404
	}

	header X-Content-Type-Options nosniff
	handle {
		reverse_proxy api:43812
	}
}

:8082 {
	header X-Content-Type-Options nosniff

	@registry_read {
		path /v2 /v2/*
		method GET HEAD
	}
	handle @registry_read {
		reverse_proxy registry:5000
	}

	handle {
		respond "Image uploads require SSH access." 405
	}
}
