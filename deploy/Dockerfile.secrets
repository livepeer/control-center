FROM golang:1.27.3-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api ./api
COPY runtime ./runtime
COPY schema ./schema
COPY secrets ./secrets
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /secrets-service ./api/cmd/secrets-service
FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /secrets-service /usr/local/bin/secrets-service
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/secrets-service"]
