{
  "uid": "lp-fleet",
  "title": "Fleet overview",
  "description": "Every machine pushing telemetry. Silent machines stopped pushing; check the machine status page and relay metrics.",
  "tags": [
    "telemetry"
  ],
  "editable": false,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "orchestrator",
        "label": "Orchestrator",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(up{job=\"node-exporter\"}, orchestrator)",
          "refId": "orchestrator"
        },
        "definition": "label_values(up{job=\"node-exporter\"}, orchestrator)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Machines reporting",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "count(max by (node_id) (up{job=\"node-exporter\", orchestrator=~\"$orchestrator\"}))",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Silent for 5m (seen in 7d)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "count((time() - max by (node_id) (tlast_over_time(up{job=\"node-exporter\", orchestrator=~\"$orchestrator\"}[7d]))) > 300) or vector(0)",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 2,
      "description": "Machines that pushed within the last 7 days but not in the last 5 minutes. Machines silent for longer drop out."
    },
    {
      "type": "stat",
      "title": "Pods restarting (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "count(increase(kube_pod_container_status_restarts_total{orchestrator=~\"$orchestrator\"}[1h]) > 0) or vector(0)",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "OOM kills (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "sum(increase(container_oom_events_total{orchestrator=~\"$orchestrator\"}[1h])) or vector(0)",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 4
    },
    {
      "type": "table",
      "title": "Machines",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "max by (node_id, orchestrator) (time() - tlast_over_time(up{job=\"node-exporter\", orchestrator=~\"$orchestrator\"}[7d]))",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "B",
          "expr": "1 - avg by (node_id, orchestrator) (rate(node_cpu_seconds_total{mode=\"idle\", orchestrator=~\"$orchestrator\"}[5m]))",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "C",
          "expr": "max by (node_id, orchestrator) (1 - node_memory_MemAvailable_bytes{orchestrator=~\"$orchestrator\"} / node_memory_MemTotal_bytes{orchestrator=~\"$orchestrator\"})",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "D",
          "expr": "max by (node_id, orchestrator) (1 - node_filesystem_avail_bytes{mountpoint=\"/\", orchestrator=~\"$orchestrator\"} / node_filesystem_size_bytes{mountpoint=\"/\", orchestrator=~\"$orchestrator\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge"
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Seconds since last push",
              "Value #B": "CPU used",
              "Value #C": "Memory used",
              "Value #D": "Root disk used"
            }
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "id": 5,
      "description": "Machines that pushed within the last 7 days. Silent machines show their last push age and no current stats."
    },
    {
      "type": "timeseries",
      "title": "CPU used",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "1 - avg by (node_id) (rate(node_cpu_seconds_total{mode=\"idle\", orchestrator=~\"$orchestrator\"}[5m]))",
          "legendFormat": "{{node_id}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Memory used",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "1 - node_memory_MemAvailable_bytes{orchestrator=~\"$orchestrator\"} / node_memory_MemTotal_bytes{orchestrator=~\"$orchestrator\"}",
          "legendFormat": "{{node_id}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Root disk used",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "1 - node_filesystem_avail_bytes{mountpoint=\"/\", orchestrator=~\"$orchestrator\"} / node_filesystem_size_bytes{mountpoint=\"/\", orchestrator=~\"$orchestrator\"}",
          "legendFormat": "{{node_id}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Host network",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "sum by (node_id) (rate(container_network_receive_bytes_total{job=\"kubelet-cadvisor\", id=\"/\", orchestrator=~\"$orchestrator\"}[5m]))",
          "legendFormat": "{{node_id}} in"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "B",
          "expr": "sum by (node_id) (rate(container_network_transmit_bytes_total{job=\"kubelet-cadvisor\", id=\"/\", orchestrator=~\"$orchestrator\"}[5m]))",
          "legendFormat": "{{node_id}} out"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "id": 9
    }
  ]
}
