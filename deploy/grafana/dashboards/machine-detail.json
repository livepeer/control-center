{
  "uid": "lp-machine",
  "title": "Machine detail",
  "description": "Host, workload, Node and ingress metrics plus logs for one machine.",
  "tags": [
    "telemetry"
  ],
  "editable": false,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "orchestrator",
        "label": "Orchestrator",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(up{job=\"node-exporter\"}, orchestrator)",
          "refId": "orchestrator"
        },
        "definition": "label_values(up{job=\"node-exporter\"}, orchestrator)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "node_id",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(up{job=\"node-exporter\", orchestrator=~\"$orchestrator\"}, node_id)",
          "refId": "node_id"
        },
        "definition": "label_values(up{job=\"node-exporter\", orchestrator=~\"$orchestrator\"}, node_id)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": null
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU used",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "1 - avg by (node_id) (rate(node_cpu_seconds_total{mode=\"idle\", node_id=~\"$node_id\"}[5m]))",
          "legendFormat": "cpu"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Memory used",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "1 - node_memory_MemAvailable_bytes{node_id=~\"$node_id\"} / node_memory_MemTotal_bytes{node_id=~\"$node_id\"}",
          "legendFormat": "memory"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Root disk used",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "1 - node_filesystem_avail_bytes{mountpoint=\"/\", node_id=~\"$node_id\"} / node_filesystem_size_bytes{mountpoint=\"/\", node_id=~\"$node_id\"}",
          "legendFormat": "disk"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Host network",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "sum by (node_id) (rate(container_network_receive_bytes_total{job=\"kubelet-cadvisor\", id=\"/\", node_id=~\"$node_id\"}[5m]))",
          "legendFormat": "in"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "B",
          "expr": "sum by (node_id) (rate(container_network_transmit_bytes_total{job=\"kubelet-cadvisor\", id=\"/\", node_id=~\"$node_id\"}[5m]))",
          "legendFormat": "out"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Load",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "node_load1{node_id=~\"$node_id\"}",
          "legendFormat": "1m"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "B",
          "expr": "node_load5{node_id=~\"$node_id\"}",
          "legendFormat": "5m"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Pressure stalled",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "rate(node_pressure_cpu_waiting_seconds_total{node_id=~\"$node_id\"}[5m])",
          "legendFormat": "cpu"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "B",
          "expr": "rate(node_pressure_memory_waiting_seconds_total{node_id=~\"$node_id\"}[5m])",
          "legendFormat": "memory"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "C",
          "expr": "rate(node_pressure_io_waiting_seconds_total{node_id=~\"$node_id\"}[5m])",
          "legendFormat": "io"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Pod CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{job=\"kubelet-cadvisor\", node_id=~\"$node_id\", container!=\"\"}[5m]))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Pod memory",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "sum by (namespace, pod) (container_memory_working_set_bytes{job=\"kubelet-cadvisor\", node_id=~\"$node_id\", container!=\"\"})",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Container restarts (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "sum by (namespace, pod, container) (increase(kube_pod_container_status_restarts_total{node_id=~\"$node_id\"}[1h])) > 0",
          "legendFormat": "{{namespace}}/{{pod}}/{{container}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "App calls",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "sum by (app, outcome) (rate(livepeer_app_calls_total{node_id=~\"$node_id\"}[5m]))",
          "legendFormat": "{{app}} {{outcome}}"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Ingress requests",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "sum by (entrypoint, code) (rate(traefik_entrypoint_requests_total{node_id=~\"$node_id\"}[5m]))",
          "legendFormat": "{{entrypoint}} {{code}}"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Log volume",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "refId": "A",
          "expr": "{node_id=\"$node_id\"} | stats by (source) count()",
          "queryType": "statsRange"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 6
      },
      "id": 12
    },
    {
      "type": "logs",
      "title": "Recent logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "refId": "A",
          "expr": "{node_id=\"$node_id\"}",
          "queryType": "instant",
          "maxLines": 1000
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 14
      },
      "id": 13
    }
  ]
}
