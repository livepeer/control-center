# Workers Static Assets response headers. Worker routes (bootstrap files and
# /api) set their own headers in worker/index.ts.
#
# The CSP is report-only until a production session shows no violations in
# the browser console; then rename the header to Content-Security-Policy.
# style.css loads Google Fonts; Supabase and the API/secrets origins come
# from deployment configuration.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://controlcenter-api.livepeer.live https://controlcenter-secrets.livepeer.live https://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Vite fingerprints everything under /assets, so it can be cached forever.
# HTML keeps the platform default (revalidated on every load), so a new
# release is picked up on the next navigation.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
